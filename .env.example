# Токен бота Telegram (получить у @BotFather)
TELEGRAM_BOT_TOKEN=""

# Опциональный Chat ID (основные получатели берутся из базы данных subscribers.db)
TELEGRAM_CHAT_ID=""

# Путь к базе данных подписчиков
DATABASE_PATH="subscribers.db"

# Минимальный порог чистой прибыли в процентах (по умолчанию 15.0%)
MIN_PROFIT_PERCENT=15.0

# Комиссия торговой площадки при продаже (по умолчанию 15.0%)
MARKET_FEE_PERCENT=15.0

# Интервал проверки рынка в секундах (по умолчанию 2.0)
CHECK_INTERVAL_SECONDS=2.0
